# Copy this file to .env and adjust as needed

# HuggingFace model ID (default: Qwen/Qwen2-Audio-7B-Instruct)
MODEL_NAME=Qwen/Qwen2-Audio-7B-Instruct

# Set to "true" to run in mock mode (no GPU / model download required)
# Useful for UI development and CI
USE_MOCK=false

# Optional: HuggingFace token for gated models
# HF_TOKEN=hf_...
